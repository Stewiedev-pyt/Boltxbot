# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF...
# Comma separated list of numeric Telegram user IDs allowed to use the bot. Empty = open.
ALLOWED_USER_IDS=

# --- Solana ---
# RPC endpoint (public or private). Use a reliable endpoint for production.
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Comma separated Jupiter v6 API hosts (fallback order).
JUPITER_QUOTE_API=https://public.jupiter.community/v6,https://quote-api.jup.ag/v6

# --- Ethereum ---
# Use a reliable RPC for production (e.g. Alchemy/Infura).
ETH_RPC=https://ethereum-rpc.publicnode.com
# Uniswap V2 Router02 contract
ETH_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
# Wrapped native token (WETH)
ETH_WRAPPED=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# USDC token used as base for buys/sells in amount mode
ETH_BASE_TOKEN=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# --- BNB Chain ---
BNB_RPC=https://bsc-dataseed.binance.org
# PancakeSwap V2 Router
BNB_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
# Wrapped native token (WBNB)
BNB_WRAPPED=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# USDT on BNB Chain used as base token
BNB_BASE_TOKEN=0x55d398326f99059fF775485246999027B3197955

# --- Wallet security ---
# 32+ char passphrase used to encrypt stored private keys (AES-256-GCM).
# Store securely; if lost, imported/created wallets cannot be recovered.
WALLET_SECRET=change-me-to-a-strong-passphrase

# --- Services ---
# Poll interval in ms for copy-trading balance checks
COPYTRADE_POLL_MS=15000
# Poll interval in ms for sniper (new pair scanning)
SNIPER_POLL_MS=10000

# --- Logging ---
LOG_LEVEL=info
